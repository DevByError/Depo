{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/target",
      "!**/src-tauri/gen",
      "!**/binaries",
      "!**/playwright-report",
      "!**/test-results",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": { "noNonNullAssertion": "warn" },
      "a11y": { "noNoninteractiveTabindex": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["packages/engine/src/blocks/**"],
      "linter": { "rules": { "complexity": { "noUselessStringRaw": "off" } } }
    }
  ],
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } },
  "css": { "parser": { "tailwindDirectives": true } }
}
